# =============================================================================
# wildfire-marl — .gitignore
#
# Policy: the repository tracks source, configs, frozen result tables/logs and
# the dashboard. It never tracks model weights, raw rasters, rendered media, or
# LaTeX build output — those are large, regenerable, or published elsewhere.
# Broad rules below are root-anchored (`/build/`, not `build/`) so they cannot
# swallow package directories such as `src/wildfire_marl/env/`.
# =============================================================================

# ---- Manuscript working directory (LaTeX sources, PDFs, build artifacts) ----
AAAI Template/

# ---- Model weights / checkpoints (published via the supplement, not git) ----
models/**
!models/README.md
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.h5
*.sb3
*.zip

# ---- Datasets: raw rasters, processed tensors, tile caches -------------------
# Raster/tensor extensions are excluded first; the re-includes at the bottom of
# this block then pin the small, deterministic inputs that CI and reviewers need.
*.npy
*.npz
*.nc
*.nc4
*.grib
*.grb
*.tif
*.tiff
*.geotiff
*.hdf
*.he5
data/**
data/geo_cache/
!data/README.md
!data/sample/
!data/sample/**
!data/cell2fire/
!data/cell2fire/**
!data/california/grids/
!data/california/grids/**
!data/saudi_eastern_province/grids/
!data/saudi_eastern_province/grids/**

# ---- Rendered media (GIF/MP4/PNG rollouts) ----------------------------------
# Regenerate with scripts/render_phase5_gifs.py and render_phase6_transfer.py;
# the web-sized copies that ship live in dashboard/public/media/.
/figures/

# ---- Regenerable result artifacts -------------------------------------------
results/logs/
results/runs/
results/**/*.parquet

# ---- Experiment tracking ----------------------------------------------------
wandb/
mlruns/
outputs/
multirun/
*tensorboard*/
events.out.tfevents.*
lightning_logs/

# ---- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
/dist/
/sdist/
/wheels/
/downloads/
/eggs/
/.eggs/
/develop-eggs/
/var/
*.egg-info/
*.egg
.installed.cfg

# ---- Virtual environments ----------------------------------------------------
/.venv/
/venv/
/venv_wsl/
/env/
/ENV/
.conda/
conda-meta/

# ---- Testing / coverage / typing / linting -----------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.cache/
.dmypy.json
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover

# ---- Jupyter -----------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ---- Node / dashboard build ---------------------------------------------------
node_modules/
dashboard/dist/
dashboard/test-results/
dashboard/playwright-report/

# ---- Secrets & credentials (never commit) -------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
.cdsapirc
.earthengine/
credentials.json
service_account*.json

# ---- Tooling / editor / OS ----------------------------------------------------
.claude/
.gstack/
.vercel/
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ---- Scratch ------------------------------------------------------------------
tmp/
temp/
_scratch/
peer_review_report_*.md
