# =============================================================================
# Wildfire-RL .gitignore  —  STRICT: protects against accidental large pushes
# The repo root is intentionally scoped to THIS project (not the home dir).
# Large binaries (models, raw data, tensors, figures) are NEVER committed.
# =============================================================================

# ---- Trained models / checkpoints (2.2 GB+ — published via HF/Zenodo) -------
# Ignore everything under models/ EXCEPT the explanatory README.
models/**
!models/README.md
*.zip
*.pt
*.pth
*.ckpt
*.onnx
*.pkl
*.h5
*.sb3

# ---- Datasets: raw + processed + generated tensors --------------------------
# Ignore everything under data/ (re-includes for the sample + README are at the
# END of this file so they override the *.npy / *.tif rules below).
data/**
!data/README.md
*.npy
*.npz
*.nc
*.nc4
*.grib
*.grb
*.tif
*.tiff
*.geotiff
*.hdf
*.he5

# ---- Results that are regenerable (keep only canonical small CSVs) ----------
results/logs/
results/runs/
results/Legacy/
results/**/*.parquet

# ---- Figures (generated; paper-final figures live under docs/paper/) --------
figures/*.png
figures/*.jpg
figures/*.jpeg
figures/*.gif
figures/*.svg
figures/*.pdf
figures/phase5*/
figures/phase5_geo/
!figures/.gitkeep

# ---- GIS basemap tile cache (contextily) ------------------------------------
data/geo_cache/

# ---- Experiment tracking ----------------------------------------------------
wandb/
mlruns/
outputs/
multirun/
*tensorboard*/
events.out.tfevents.*
lightning_logs/

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
pip-log.txt
pip-delete-this-directory.txt

# ---- Virtual environments (root-anchored! bare `env/` would also ignore the
# wildfire_marl.env PACKAGE — that bug silently dropped src/wildfire_marl/env/) --
/.venv/
/venv/
/env/
/ENV/
.conda/
conda-meta/

# ---- Testing / coverage / typing / linting ----------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
coverage.xml
*.cover

# ---- Jupyter ----------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ---- Secrets / credentials (NEVER commit) -----------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.json.key
.cdsapirc
.earthengine/
credentials.json
service_account*.json
*secret*
*token*

# ---- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Misc temp --------------------------------------------------------------
tmp/
temp/
_scratch/
_code/
_audit_*.py
_dump.py
_smoke.py
_prep.py

# ---- V1 archive (frozen, Phase 0 of REMEDIATION_PLAN_V2) --------------------
# Large V1 artifacts stay untracked exactly as they were at the old paths.
legacy_v1/models/**
!legacy_v1/models/README.md
legacy_v1/results/logs/
legacy_v1/results/runs/
legacy_v1/results/Legacy/
legacy_v1/figures/*.png
legacy_v1/figures/*.jpg
legacy_v1/figures/*.jpeg
legacy_v1/figures/*.gif
legacy_v1/figures/*.svg
legacy_v1/figures/*.pdf
!legacy_v1/figures/.gitkeep

# ---- Keep the tiny committed sample (MUST be last to override *.npy etc.) ----
!data/sample/
!data/sample/**

/legacy_v1
# ---- Keep generated Cell2Fire landscapes (small, deterministic, manifest-hashed;
#      Phase 2) — committed so CI and reviewers can run the simulator directly ----
!data/cell2fire/
!data/cell2fire/**
# ---- AAAI Paper intermediates -----------------------------------------------
AAAI Template/*.aux
AAAI Template/*.bbl
AAAI Template/*.blg
AAAI Template/*.log
AAAI Template/*.synctex.gz
AAAI Template/*.out

# ---- Cell2Fire C++ compiled binaries and intermediates ----------------------
third_party/firehose/cell2fire/Cell2FireC/Cell2Fire
third_party/firehose/cell2fire/Cell2FireC/*.o
third_party/firehose/cell2fire/Cell2FireC/*.gch
/venv_wsl

# ---- Dashboard (static results site; see dashboard/README.md) ---------------
# Re-include source files caught by broad rules above (`lib/`, `*token*`);
# node_modules/dist/media stay ignored via dashboard/.gitignore.
!dashboard/src/lib/
!dashboard/src/lib/**
!dashboard/src/theme/tokens.css
dashboard/node_modules/
dashboard/dist/
Dashboard_Guide.md

.vercel
.env*
.gstack/
peer_review_report_AAAI2027_HierComm.md

