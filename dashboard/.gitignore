# Dependencies and build output
node_modules/
dist/

# Rollout media is copied here by scripts/build_dashboard_data.py --copy-media.
# The dashboard plays MP4 + PNG posters (~80 MB) — those are committed so the site
# deploys from git. The source GIFs total ~455 MB and are excluded (repo policy forbids
# large binaries; nothing in the app renders them — MediaFrame uses src/poster only).
public/media/**/*.gif

# Frozen-artifact download copies (regenerated by the build script)
public/data/downloads/
