# Copy to `.env` and fill in. `.env` is git-ignored — never commit real credentials.
# These are read by scripts/download_data.py and the data pipelines.

# Copernicus Climate Data Store (ERA5)   -> https://cds.climate.copernicus.eu/api-how-to
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your-uid:your-api-key

# NASA FIRMS active-fire API key          -> https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_MAP_KEY=your-firms-map-key

# Google Earth Engine cloud project id    -> https://console.cloud.google.com/
EE_PROJECT_ID=your-ee-project-id

# Optional: override default data/model roots (otherwise resolved from repo root)
# WILDFIRE_DATA_DIR=/abs/path/to/data
# WILDFIRE_MODELS_DIR=/abs/path/to/models

# Optional: Hugging Face Hub token for fetching/pushing checkpoints
# HF_TOKEN=hf_xxx
